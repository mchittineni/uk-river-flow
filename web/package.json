{
  "name": "uk-river-flow-web",
  "version": "1.0.0",
  "private": true,
  "description": "Static front end for the UK river flow map",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src scripts *.js --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,css}\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.js\" index.html",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"test/**/*.js\" \"scripts/**/*.mjs\" \"*.js\" index.html",
    "test": "node --test",
    "check:headers": "node scripts/check-headers.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "vite": "^6.0.0"
  }
}
